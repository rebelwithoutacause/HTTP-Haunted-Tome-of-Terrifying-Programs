{
  "name": "spooky-recipes-app",
  "version": "1.0.0",
  "description": "Spooky Halloween Recipes - Full Stack Application",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "node serve.js",
    "dev:backend": "cd backend && node server.js",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "test": "cd backend && npm test && cd ../frontend && npm test"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "eslint": "^8.45.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}